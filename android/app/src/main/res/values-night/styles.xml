<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting (Night Mode) -->
    <style name="LaunchTheme" parent="@android:style/Theme.NoTitleBar">
        <!-- Aura dark splash background -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    
    <!-- Theme applied to the Android Window as soon as the process has started (Night Mode) -->
    <style name="NormalTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@color/aura_splash_background</item>
    </style>
</resources>
