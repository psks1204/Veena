<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ship exactly the version/build from pubspec.yaml. Xcode defaults this
	     to true for app-store-connect exports, which silently rewrites the
	     build number at export time (it turned 2.0.4+13 into 14). -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>JHD97LCWTM</string>
	<key>signingStyle</key>
	<string>automatic</string>
</dict>
</plist>
